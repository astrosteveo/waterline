{
  "description": "Missing five buoys in one race disqualifies the player: the race ends for them and the HUD says so.",
  "start": {"scene": "res://race/race.tscn", "seed": 1},
  "steps": [
    {"until": "phase == 1", "max": 400},
    {"eval": "place_racer(player, 240, 0, 0)"},
    "step 5",
    {"expect": "player.buoys_missed", "equals": 4, "name": "four buoys skipped"},
    {"expect": "not player.disqualified", "name": "four misses: still racing"},
    {"expect": "get_node('RaceHud')._misses.value", "equals": 4, "name": "the HUD shows four misses"},
    {"eval": "place_racer(player, 310, 0, 0)"},
    "step 5",
    {"expect": "player.disqualified", "name": "the fifth miss disqualifies"},
    {"expect": "phase", "equals": 2, "name": "the race is over for the player"},
    "step 10",
    {"expect": "get_node('RaceHud')._message.text", "equals": "DISQUALIFIED"},
    {"expect": "get_node('RaceHud')._place_value.text", "equals": "DQ"},
    {"eval": "place_racer(player, 400, 5, 0)"},
    "step 5",
    {"expect": "player.buoys_missed", "equals": 5, "name": "no more buoys are judged"}
  ]
}
