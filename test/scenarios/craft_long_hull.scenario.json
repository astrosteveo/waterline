{
  "description": "The long-hull example craft (craft/long_hull.tscn, an inherited scene of jetski.tscn with a longer collision box, stretched buoyancy points and the stern boarding point moved back) crashes and remounts like the base craft: a pillar hit and a nose-first landing throw the rider off, a clean ramp landing and a wall scrape don't, and a rider swimming up from behind climbs on at the moved stern boarding point.",
  "start": {
    "scene": "res://test/race_long_hull.tscn",
    "seed": 1,
    "args": [
      "--no-opponents"
    ]
  },
  "steps": [
    {
      "until": "phase == 1",
      "max": 400
    },
    {
      "expect": "[player.craft_profile.id, player.craft.scene_file_path, player.craft.get_node('Collision').shape.size.z, player.craft.boarding_points[2]]",
      "equals": [
        "long_hull_test",
        "res://craft/long_hull.tscn",
        3.5,
        [0.0, 0.0, 2.1]
      ],
      "name": "the player rides the long hull, with its stern boarding point moved back"
    },
    {
      "eval": "rules.set('misses_to_disqualify', 0)",
      "name": "no disqualification: this test skips buoys"
    },
    {
      "eval": "place_racer(player, 311, -9, 15)"
    },
    "step 3",
    {
      "until": "player.craft.rider_state != 0",
      "hold": "throttle",
      "max": 60,
      "name": "hitting the pillar at 54 km/h throws the rider off"
    },
    {
      "expect": "player.craft.last_crash_reason",
      "equals": "impact"
    },
    {
      "until": "player.craft.rider_state == 2",
      "hold": "throttle",
      "max": 120,
      "name": "the rider lands in the water and swims"
    },
    {
      "until": "player.craft.rider_state == 0",
      "hold": "throttle",
      "max": 420,
      "name": "and is back on within 7 s"
    },
    {
      "eval": "place_racer(player, 100, 0, 12)"
    },
    "step 3",
    {
      "eval": "player.craft.set('global_transform', Transform3D(Basis(player.craft.global_basis.x, -0.8) * player.craft.global_basis, player.craft.global_position + Vector3(0, 2.5, 0)))",
      "name": "drop the craft from 2.5 m, 46 degrees nose down"
    },
    {
      "until": "player.craft.rider_state != 0",
      "max": 90,
      "name": "landing nose first throws the rider off"
    },
    {
      "expect": "player.craft.last_crash_reason",
      "equals": "nose_dive"
    },
    {
      "until": "player.craft.rider_state == 0",
      "max": 600,
      "name": "back on again"
    },
    {
      "eval": "place_racer(player, 394, -1, 15)"
    },
    "step 3",
    {
      "until": "player.craft.airborne",
      "hold": "throttle",
      "max": 200
    },
    {
      "until": "not player.craft.airborne",
      "hold": "throttle",
      "max": 200
    },
    "step 2",
    {
      "expect": "abs(player.craft.last_landing.pitch) < 25",
      "name": "with no lean the craft lands flat enough"
    },
    {
      "expect": "player.crashes",
      "equals": 2,
      "name": "a clean landing doesn't crash"
    },
    {
      "eval": "place_racer(player, 600, 0, 15)"
    },
    "step 3",
    {
      "step": 40,
      "hold": [
        "throttle",
        "steer_right"
      ]
    },
    {
      "step": 120,
      "hold": "throttle"
    },
    {
      "expect": "player.progress.lateral > 15",
      "name": "the craft rode into the wall"
    },
    {
      "expect": "player.crashes",
      "equals": 2,
      "name": "walls don't crash"
    },
    {
      "eval": "place_racer(player, 100, 0, 0)",
      "name": "stopped on open water"
    },
    "step 60",
    {
      "eval": "player.craft.throw_rider('impact')"
    },
    {
      "until": "player.craft.rider_state == 2",
      "max": 120,
      "name": "the rider is in the water"
    },
    {
      "eval": "player.craft.set('_rider_position', player.craft.global_transform * Vector3(0, 0, 9))",
      "name": "put the swimmer 9 m behind the craft"
    },
    {
      "eval": "player.craft.set('_rider_previous', player.craft.global_transform * Vector3(0, 0, 9))"
    },
    {
      "until": "player.craft.rider_state == 3",
      "max": 400,
      "name": "the rider swims up and starts climbing on"
    },
    {
      "expect": "Vector2(player.craft.to_local(player.craft._rider_position).x, player.craft.to_local(player.craft._rider_position).z).distance_to(Vector2(0, 2.1)) <= 1.45",
      "name": "within reach of the moved stern boarding point (2.1 m behind the middle)"
    },
    {
      "expect": "Vector2(player.craft.to_local(player.craft._rider_position).x, player.craft.to_local(player.craft._rider_position).z).distance_to(Vector2(0, 1.7)) > 1.4",
      "name": "and out of reach of the base craft's stern point (1.7 m), so the rider swam to the moved one"
    },
    {
      "until": "player.craft.rider_state == 0",
      "max": 120,
      "name": "and is back on"
    }
  ]
}
