{
  "description": "Riders: the rider select screen shows each rider's line and weight, and no craft stats; choosing one (then their own craft and a course) races as that rider on that craft, tuned by the craft's stats and the rider's weight, against the other three on their own craft.",
  "start": {
    "scene": "res://menus/rider_select.tscn",
    "seed": 1
  },
  "steps": [
    "step 10",
    {
      "expect": "scene.selected.display_name",
      "equals": "Marina",
      "name": "Marina is chosen first"
    },
    {
      "expect": "[scene._weight.value, scene.find_children('*', 'StatBar', true, false).size()]",
      "equals": [
        3.0,
        1
      ],
      "name": "Marina is a middle weight, and the weight is the only bar"
    },
    {
      "expect": "scene._tagline.text",
      "equals": "A middle weight. A safe first pick."
    },
    {
      "step": 3,
      "tap": "ui_down"
    },
    "step 5",
    {
      "expect": "[scene.selected.display_name, scene._weight.value]",
      "equals": [
        "Koa",
        5.0
      ],
      "name": "Koa is the heaviest (330 kg)"
    },
    {
      "step": 3,
      "tap": "ui_down"
    },
    "step 5",
    {
      "expect": "[scene.selected.display_name, scene._weight.value]",
      "equals": [
        "Ines",
        1.5
      ],
      "name": "Ines is the lightest (280 kg)"
    },
    {
      "step": 3,
      "tap": "ui_down"
    },
    "step 5",
    {
      "expect": "[scene.selected.display_name, scene._weight.value]",
      "equals": [
        "Dax",
        2.5
      ],
      "name": "Dax is light (290 kg)"
    },
    {
      "step": 3,
      "tap": "ui_down"
    },
    "step 5",
    {
      "expect": "scene.selected.display_name",
      "equals": "Marina",
      "name": "the list wraps round"
    },
    {
      "step": 3,
      "tap": "ui_up"
    },
    {
      "step": 3,
      "tap": "ui_up"
    },
    {
      "step": 3,
      "tap": "ui_accept"
    },
    {
      "until": "scene.name == 'CraftSelect'",
      "max": 60,
      "name": "confirming a rider opens the craft select"
    },
    "step 5",
    {
      "expect": "scene.selected.id",
      "equals": "petrel",
      "name": "Ines's own craft has the focus first"
    },
    {
      "step": 3,
      "tap": "ui_accept"
    },
    {
      "until": "scene.name == 'CourseSelect'",
      "max": 60,
      "name": "confirming the craft opens the course select"
    },
    "step 5",
    {
      "step": 3,
      "tap": "ui_accept"
    },
    {
      "until": "scene.name == 'Race'",
      "max": 60,
      "name": "confirming the course starts the race"
    },
    "step 5",
    {
      "expect": "scene.player.display_name",
      "equals": "Ines",
      "name": "as the chosen rider"
    },
    {
      "expect": "[scene.player_craft.id, scene.player.craft_profile.id, Game.player_craft.id]",
      "equals": [
        "petrel",
        "petrel",
        "petrel"
      ],
      "name": "on the rider's default craft"
    },
    {
      "expect": "[scene.racers[1].display_name, scene.racers[2].display_name, scene.racers[3].display_name]",
      "equals": [
        "Marina",
        "Koa",
        "Dax"
      ],
      "name": "against the other three"
    },
    {
      "expect": "abs(scene.player.craft.tuning.turn_rate_low - 1.6 * 1.12) < 0.001",
      "name": "the craft has the Petrel's handling"
    },
    {
      "expect": "abs(scene.player.craft.mass - 280.0) < 0.01",
      "name": "and Ines's weight"
    },
    {
      "expect": "abs(scene.racers[2].craft.tuning.grip_g - 1.9) < 0.001 and abs(scene.racers[3].craft.tuning.grip_g - 1.9 * 0.88) < 0.001",
      "name": "the computer riders ride their own craft"
    },
    {
      "expect": "[scene.racers[1].craft_profile.id, scene.racers[2].craft_profile.id, scene.racers[3].craft_profile.id]",
      "equals": [
        "tradewind",
        "swordfish",
        "skipjack"
      ],
      "name": "each on their default craft"
    }
  ]
}
