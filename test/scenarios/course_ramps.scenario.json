{
  "description": "Riding over Gull Cove's first ramp at speed launches the craft off the lip (not before it), it flies most of a second and rides on.",
  "start": {"scene": "res://race/race.tscn", "seed": 1},
  "steps": [
    {"until": "phase == 1", "max": 400},
    {"eval": "place_racer(player, 394, -1, 15)"},
    "step 3",
    {"eval": "get_node('RideRecorder').reset()"},
    {"until": "player.craft.airborne", "hold": "throttle", "max": 240, "name": "the craft leaves the ramp"},
    {"expect": "player.progress.offset > 416.5", "name": "airborne only past the lip (lip at 418)"},
    {"until": "not player.craft.airborne", "hold": "throttle", "max": 180, "name": "and lands"},
    {"step": 30, "hold": "throttle"},
    {"expect": "get_node('RideRecorder').report().longest_air_s > 0.9", "name": "in the air for over 0.9 s"},
    {"expect": "get_node('RideRecorder').report().highest_clearance_m > 1.2", "name": "over 1.2 m above the water"},
    {"expect": "player.craft.speed > 10", "name": "rides on after landing (over 36 km/h)"}
  ]
}
