[layer_names]

3d_render/layer_1="scenery"
3d_render/layer_2="moving"
3d_render/layer_3="water"
3d_render/layer_20="shore capture"
3d_physics/layer_1="scenery"
3d_physics/layer_2="craft"
3d_physics/layer_3="walls"
3d_physics/layer_4="floating"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=2

[shader_globals]

sun_direction={
"type": "vec3",
"value": Vector3(0.32, 0.6, -0.73)
}
shore_height_map={
"type": "sampler2D",
"value": ""
}
shore_map_rect={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
