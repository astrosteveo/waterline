{
  "description": "Championship: from the main menu, the cup select (the Coast Cup holds today's four courses at today's skill; the Pro Cup, chosen here, makes the computer riders sharper and races Gull Cove Swell in place of Gull Cove), each race's weather drawn from the championship's seed and shown on the craft select and the standings, then four one-lap races on the cup's courses in turn, points for each place (10, 6, 3, 1), standings under the cup's name after each race, the champion at the end, then back to the main menu.",
  "start": {
    "scene": "res://menus/main_menu.tscn",
    "seed": 4,
    "args": [
      "--laps",
      "1"
    ]
  },
  "steps": [
    "step 5",
    {
      "step": 3,
      "tap": "ui_accept"
    },
    {
      "until": "scene.name == 'CupSelect'",
      "max": 60,
      "name": "championship opens the cup select"
    },
    {
      "expect": "Game.mode",
      "equals": 1
    },
    "step 5",
    {
      "expect": "scene.get_viewport().gui_get_focus_owner().name",
      "equals": "coast_cup",
      "name": "the first cup has the focus"
    },
    {
      "expect": "[Game.cups[0].courses.size(), Game.cups[0].courses[0].id, Game.cups[0].courses[3].id, Game.cups[0].skill_offset]",
      "equals": [
        4,
        "gull_cove",
        "ebb_reef",
        0.0
      ],
      "name": "the Coast Cup is today's championship: the four courses at today's skill"
    },
    {
      "step": 3,
      "tap": "ui_down"
    },
    "step 3",
    {
      "expect": "scene.selected.id",
      "equals": "pro_cup"
    },
    {
      "step": 3,
      "tap": "ui_accept"
    },
    {
      "until": "scene.name == 'RiderSelect'",
      "max": 60
    },
    "step 5",
    {
      "step": 3,
      "tap": "ui_accept"
    },
    {
      "until": "scene.name == 'CraftSelect'",
      "max": 60
    },
    {
      "expect": "[Game.championship.forecasts[0].describe(3), Game.championship.forecasts[1].describe(3), Game.championship.forecasts[2].describe(3), Game.championship.forecasts[3].describe(3)]",
      "equals": [
        "FOG, THEN STORM ON LAP 2",
        "CLEAR",
        "CLEAR, THEN OVERCAST ON LAP 2",
        "STORM, THEN FOG ON LAP 3"
      ],
      "name": "seed 4 gives these forecasts"
    },
    {
      "expect": "[Game.championship.draw_forecasts(Game.championship.courses, Game.championship.weather_seed, 3)[0].describe(3), Game.championship.draw_forecasts(Game.championship.courses, Game.championship.weather_seed, 3)[3].describe(3)]",
      "equals": [
        "FOG, THEN STORM ON LAP 2",
        "STORM, THEN FOG ON LAP 3"
      ],
      "name": "the same seed draws the same forecasts again"
    },
    {
      "expect": "scene.find_child('Forecast', true, false).text",
      "equals": "FORECAST: FOG, THEN STORM ON LAP 2",
      "name": "the craft select shows race 1's forecast"
    },
    "step 3",
    {
      "step": 3,
      "tap": "ui_accept"
    },
    {
      "until": "scene.name == 'Race'",
      "max": 120
    },
    "step 3",
    {
      "expect": "[Game.course.id, scene.forecast == Game.championship.forecasts[0], scene.weather.weather.id, snappedf(Ocean.wave_set.max_height(), 0.001)]",
      "equals": [
        "gull_cove_swell",
        true,
        "fog",
        1.45
      ],
      "name": "race 1 is on Gull Cove Swell's swell, in its forecast weather"
    },
    {
      "expect": "[scene.racers[1].craft.get_node('AIDriver').skill, scene.racers[2].craft.get_node('AIDriver').skill, scene.racers[3].craft.get_node('AIDriver').skill]",
      "approx": [
        1.0,
        0.9,
        0.8
      ],
      "within": 0.001,
      "name": "the Pro Cup's +0.1 skill reaches the computer riders (Koa 0.9, Ines 0.8, Dax 0.7)"
    },
    {
      "eval": "scene.autopilot(scene.player, 1.0)"
    },
    {
      "until": "scene.get_node('ResultsScreen').is_open()",
      "max": 9000,
      "name": "race 1 ends with the results"
    },
    "step 5",
    {
      "expect": "scene.get_node('ResultsScreen')._course_name.text",
      "equals": "GULL COVE SWELL",
      "name": "the results name race 1's course Gull Cove Swell"
    },
    {
      "expect": "scene.get_viewport().gui_get_focus_owner().name",
      "equals": "Continue",
      "name": "the results offer CONTINUE"
    },
    {
      "step": 3,
      "tap": "ui_accept"
    },
    {
      "until": "scene.name == 'Standings'",
      "max": 60,
      "name": "then the standings"
    },
    "step 5",
    {
      "expect": "Game.championship.race_index",
      "equals": 1
    },
    {
      "expect": "scene.find_child('Cup', true, false).text",
      "equals": "PRO CUP",
      "name": "the standings show the cup's name"
    },
    {
      "expect": "[scene.find_child('Forecast', true, false).text, scene.find_child('ChangeCraft', true, false) != null]",
      "equals": [
        "FORECAST: CLEAR",
        true
      ],
      "name": "the standings show race 2's forecast and offer CHANGE CRAFT"
    },
    {
      "expect": "Game.championship.points['Marina'] + Game.championship.points['Koa'] + Game.championship.points['Ines'] + Game.championship.points['Dax']",
      "equals": 20,
      "name": "20 points handed out per race"
    },
    {
      "step": 3,
      "tap": "ui_accept"
    },
    {
      "until": "scene.name == 'Race'",
      "max": 120
    },
    "step 3",
    {
      "expect": "scene.course.course_name",
      "equals": "Whitecap Point",
      "name": "race 2 is on Whitecap Point"
    },
    {
      "expect": "scene.forecast == Game.championship.forecasts[1]",
      "name": "race 2 runs in its forecast weather"
    },
    {
      "eval": "scene.autopilot(scene.player, 1.0)"
    },
    {
      "until": "scene.get_node('ResultsScreen').is_open()",
      "max": 9000,
      "name": "race 2 ends with the results"
    },
    "step 5",
    {
      "expect": "scene.get_viewport().gui_get_focus_owner().name",
      "equals": "Continue",
      "name": "the results offer CONTINUE"
    },
    {
      "step": 3,
      "tap": "ui_accept"
    },
    {
      "until": "scene.name == 'Standings'",
      "max": 60,
      "name": "then the standings"
    },
    "step 5",
    {
      "expect": "Game.championship.race_index",
      "equals": 2
    },
    {
      "expect": "Game.championship.points['Marina'] + Game.championship.points['Koa'] + Game.championship.points['Ines'] + Game.championship.points['Dax']",
      "equals": 40,
      "name": "20 points handed out per race"
    },
    {
      "step": 3,
      "tap": "ui_accept"
    },
    {
      "until": "scene.name == 'Race'",
      "max": 120
    },
    "step 3",
    {
      "expect": "scene.course.course_name",
      "equals": "Lantern Harbor",
      "name": "race 3 is on Lantern Harbor"
    },
    {
      "eval": "scene.autopilot(scene.player, 1.0)"
    },
    {
      "until": "scene.get_node('ResultsScreen').is_open()",
      "max": 9000,
      "name": "race 3 ends with the results"
    },
    "step 5",
    {
      "expect": "scene.get_viewport().gui_get_focus_owner().name",
      "equals": "Continue",
      "name": "the results offer CONTINUE"
    },
    {
      "step": 3,
      "tap": "ui_accept"
    },
    {
      "until": "scene.name == 'Standings'",
      "max": 60,
      "name": "then the standings"
    },
    "step 5",
    {
      "expect": "Game.championship.race_index",
      "equals": 3
    },
    {
      "expect": "Game.championship.points['Marina'] + Game.championship.points['Koa'] + Game.championship.points['Ines'] + Game.championship.points['Dax']",
      "equals": 60,
      "name": "20 points handed out per race"
    },
    {
      "step": 3,
      "tap": "ui_accept"
    },
    {
      "until": "scene.name == 'Race'",
      "max": 120
    },
    "step 3",
    {
      "expect": "scene.course.course_name",
      "equals": "Ebb Reef",
      "name": "race 4 is on Ebb Reef"
    },
    {
      "eval": "scene.autopilot(scene.player, 1.0)"
    },
    {
      "until": "scene.get_node('ResultsScreen').is_open()",
      "max": 9000,
      "name": "race 4 ends with the results"
    },
    "step 5",
    {
      "expect": "scene.get_viewport().gui_get_focus_owner().name",
      "equals": "Continue",
      "name": "the results offer CONTINUE"
    },
    {
      "step": 3,
      "tap": "ui_accept"
    },
    {
      "until": "scene.name == 'Standings'",
      "max": 60,
      "name": "then the standings"
    },
    "step 5",
    {
      "expect": "Game.championship.race_index",
      "equals": 4
    },
    {
      "expect": "Game.championship.points['Marina'] + Game.championship.points['Koa'] + Game.championship.points['Ines'] + Game.championship.points['Dax']",
      "equals": 80,
      "name": "20 points handed out per race"
    },
    {
      "expect": "scene.find_child('Title', true, false).text.begins_with('CHAMPION: ')",
      "name": "after the last race: the champion"
    },
    {
      "expect": "scene.find_child('Cup', true, false).text",
      "equals": "PRO CUP",
      "name": "the champion screen shows the cup's name"
    },
    {
      "step": 3,
      "tap": "ui_accept"
    },
    {
      "until": "scene.name == 'MainMenu'",
      "max": 60,
      "name": "back to the main menu"
    },
    {
      "expect": "Game.championship == null"
    }
  ]
}
