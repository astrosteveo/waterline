{
  "description": "Craft scenes: each racer rides the scene of its own craft. Koa's default craft is switched to a test craft with a scene of its own and Dax's to one with no scene, and both join the craft list; the rider select and the craft select swap the craft on the water, and the race puts Koa on the test scene and everyone else, Dax included, on jetski.tscn.",
  "start": {
    "scene": "res://menus/rider_select.tscn",
    "seed": 1
  },
  "steps": [
    "step 5",
    {
      "eval": "Game.riders[1].set('default_craft', ResourceLoader.load('res://test/craft/test_hull.tres'))"
    },
    {
      "eval": "Game.riders[3].set('default_craft', ResourceLoader.load('res://test/craft/no_scene.tres'))"
    },
    {
      "eval": "Game.crafts.append(Game.riders[1].default_craft)"
    },
    {
      "eval": "Game.crafts.append(Game.riders[3].default_craft)"
    },
    {
      "expect": "[scene.selected.display_name, scene._craft.scene_file_path, scene.find_children('*', 'JetSki', false, false).size()]",
      "equals": [
        "Marina",
        "res://craft/tradewind.tscn",
        1
      ],
      "name": "Marina shows on her Tradewind's scene"
    },
    {
      "step": 3,
      "tap": "ui_down"
    },
    "step 5",
    {
      "expect": "[scene.selected.display_name, scene._craft.scene_file_path, scene.find_children('*', 'JetSki', false, false).size()]",
      "equals": [
        "Koa",
        "res://test/craft/test_hull.tscn",
        1
      ],
      "name": "Koa shows on the test craft's scene, which replaces the craft on the water"
    },
    {
      "step": 3,
      "tap": "ui_down"
    },
    {
      "step": 3,
      "tap": "ui_down"
    },
    "step 5",
    {
      "expect": "[scene.selected.display_name, scene._craft.scene_file_path, scene.find_children('*', 'JetSki', false, false).size()]",
      "equals": [
        "Dax",
        "res://jetski/jetski.tscn",
        1
      ],
      "name": "a craft with no scene shows on jetski.tscn"
    },
    {
      "step": 3,
      "tap": "ui_up"
    },
    {
      "step": 3,
      "tap": "ui_up"
    },
    "step 5",
    {
      "expect": "scene.selected.display_name",
      "equals": "Koa"
    },
    {
      "step": 3,
      "tap": "ui_accept"
    },
    {
      "until": "scene.name == 'CraftSelect'",
      "max": 60,
      "name": "confirming Koa opens the craft select"
    },
    "step 5",
    {
      "expect": "[scene.selected.id, scene._craft.scene_file_path, scene.find_children('*', 'JetSki', false, false).size()]",
      "equals": [
        "test_hull",
        "res://test/craft/test_hull.tscn",
        1
      ],
      "name": "Koa's own craft, the test craft, has the focus first, on its own scene"
    },
    {
      "step": 3,
      "tap": "ui_down"
    },
    "step 5",
    {
      "expect": "[scene.selected.id, scene._craft.scene_file_path, scene.find_children('*', 'JetSki', false, false).size()]",
      "equals": [
        "no_scene",
        "res://jetski/jetski.tscn",
        1
      ],
      "name": "a craft with no scene shows on jetski.tscn, which replaces the test craft"
    },
    {
      "step": 3,
      "tap": "ui_up"
    },
    "step 5",
    {
      "expect": "[scene.selected.id, scene._craft.scene_file_path, scene.find_children('*', 'JetSki', false, false).size()]",
      "equals": [
        "test_hull",
        "res://test/craft/test_hull.tscn",
        1
      ],
      "name": "and back to the test craft's scene"
    },
    {
      "step": 3,
      "tap": "ui_accept"
    },
    {
      "until": "scene.name == 'CourseSelect'",
      "max": 60,
      "name": "confirming the test craft opens the course select"
    },
    "step 5",
    {
      "step": 3,
      "tap": "ui_accept"
    },
    {
      "until": "scene.name == 'Race'",
      "max": 60,
      "name": "confirming the course starts the race"
    },
    "step 5",
    {
      "expect": "[scene.player.display_name, scene.player_craft.id, scene.player.craft.scene_file_path]",
      "equals": [
        "Koa",
        "test_hull",
        "res://test/craft/test_hull.tscn"
      ],
      "name": "the player rides the test craft's scene"
    },
    {
      "expect": "[scene.racers[1].display_name, scene.racers[1].craft.scene_file_path, scene.racers[2].display_name, scene.racers[2].craft.scene_file_path, scene.racers[3].display_name, scene.racers[3].craft.scene_file_path]",
      "equals": [
        "Marina",
        "res://craft/tradewind.tscn",
        "Ines",
        "res://craft/petrel.tscn",
        "Dax",
        "res://jetski/jetski.tscn"
      ],
      "name": "the computer riders ride their own craft's scene, and Dax's craft with no scene falls back to Race.craft_scene"
    },
    {
      "expect": "abs(scene.player.craft.mass - 330.0) < 0.01 and abs(scene.player.craft.tuning.turn_rate_low - 1.6) < 0.001",
      "name": "the test craft takes the tuning on its scene, with Koa's weight"
    },
    "step 200",
    {
      "step": 120,
      "hold": "throttle"
    },
    {
      "expect": "scene.player.craft.speed > 5.0",
      "name": "and rides: over 5 m/s after 2 s of throttle"
    },
    {
      "eval": "Game.riders[1].set('default_craft', Game.craft_named('swordfish'))"
    },
    {
      "eval": "Game.riders[3].set('default_craft', Game.craft_named('skipjack'))"
    },
    {
      "eval": "Game.crafts.pop_back()"
    },
    {
      "eval": "Game.crafts.pop_back()"
    }
  ]
}
