{
  "description": "Gull Cove Swell: the Gull Cove scene raced on cove_swell.tres (waves twice as high as Gull Cove's) through its CourseInfo's overrides. The physics and the drawn water use the swell, and a time trial on it keeps its records and ghost apart from Gull Cove's.",
  "start": {
    "scene": "res://race/race.tscn",
    "seed": 3,
    "user_data": "fresh",
    "args": ["--mode", "time_trial", "--course", "gull_cove_swell", "--rider", "dax", "--laps", "1"]
  },
  "steps": [
    "step 3",
    {
      "expect": "[course.course_name, course.scene_file_path, time_trial.course_id]",
      "equals": ["Gull Cove Swell", "res://levels/gull_cove.tscn", "gull_cove_swell"],
      "name": "the Gull Cove scene, under the swell course's id and name"
    },
    {
      "until": "str(get_node('Announcer').history).contains('TIME TRIAL AT GULL COVE SWELL')",
      "max": 240,
      "name": "the announcer names the course Gull Cove Swell"
    },
    {
      "expect": "[course.get_node('OceanSurface').wave_set.resource_path, Ocean.wave_set.resource_path]",
      "equals": ["res://water/presets/cove_swell.tres", "res://water/presets/cove_swell.tres"],
      "name": "the drawn water and the physics ride the swell"
    },
    {
      "expect": "abs(Ocean.wave_set.max_height() - 2.0 * ResourceLoader.load('res://water/presets/cove_calm.tres').max_height()) < 0.001",
      "name": "twice the height of Gull Cove's waves"
    },
    {
      "expect": "course.get_node('WorldEnvironment').environment.resource_path",
      "equals": "res://environment/day_environment.tres",
      "name": "the scene's own sky"
    },
    {"eval": "autopilot(player, 0.9)"},
    {"until": "get_node('SoloResults').is_open()", "max": 6000, "name": "the run ends with the time trial results"},
    {
      "expect": "[player.disqualified, player.crashes]",
      "equals": [false, 0],
      "name": "the computer rides the swell without crashing"
    },
    {
      "expect": "[Game.records.best_race('gull_cove_swell') < 1000, Game.records.load_ghost('gull_cove_swell').size() > 0]",
      "equals": [true, true],
      "name": "the record and ghost are saved under the swell course"
    },
    {
      "expect": "[Game.records.best_race('gull_cove') > 1e9, Game.records.load_ghost('gull_cove').size()]",
      "equals": [true, 0],
      "name": "Gull Cove's own record and ghost are untouched"
    }
  ]
}
