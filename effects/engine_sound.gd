class_name EngineSound
extends Node3D
## A jet ski's sounds: the engine, whose pitch follows the speed and rises when the jet
## leaves the water, the hiss of water under the hull, and a splash at each landing and crash.
## All generated by [SoundBank].

## The craft. Defaults to the parent.
@export var craft: JetSki
## Engine pitch at a standstill and at the craft's top speed.
@export_range(0.1, 4.0, 0.01) var idle_pitch: float = 0.55
@export_range(0.1, 4.0, 0.01) var top_pitch: float = 1.55
## Extra pitch with the jet out of the water (no load).
@export_range(0.0, 2.0, 0.01) var air_rev: float = 0.35
## Engine volume at idle and at full throttle, in dB.
@export_range(-60.0, 12.0, 0.1) var idle_volume: float = -20.0
@export_range(-60.0, 12.0, 0.1) var full_volume: float = -9.0
## Distance at which the sounds start to fall off, in meters.
@export_range(1.0, 100.0, 0.1) var unit_size: float = 10.0

var _engine: AudioStreamPlayer3D
var _hiss: AudioStreamPlayer3D
var _splash: AudioStreamPlayer3D
var _pitch := 0.55
var _rev := 0.0


func _ready() -> void:
	if craft == null:
		craft = get_parent() as JetSki
	_engine = _player("Engine", SoundBank.engine(), &"Engine")
	_hiss = _player("Hiss", SoundBank.hiss(), &"Effects")
	_splash = _player("Splash", SoundBank.splash(), &"Effects")
	_engine.volume_db = idle_volume
	_hiss.volume_db = -60.0
	_engine.play()
	_hiss.play()
	if craft != null:
		craft.landed.connect(func(quality: StringName, _stunts: Array[StringName], _points: int) -> void:
			_splash_now(1.0 if quality != &"clean" else 0.7))
		craft.crashed.connect(func(_reason: StringName) -> void: _splash_now(1.0))


func _process(delta: float) -> void:
	if craft == null:
		return
	var top := craft.tuning.reference_top_speed if craft.tuning != null else 17.5
	var pace := clampf(craft.speed / top, 0.0, 1.3)
	var aboard := craft.is_rider_aboard()
	var thrust := craft.thrust if aboard else 0.0
	# The engine revs freely with the jet out of the water.
	var free := 1.0 if craft.airborne or craft.contact < 0.15 else 0.0
	_rev = move_toward(_rev, free * thrust, delta * 3.0)
	var target := lerpf(idle_pitch, top_pitch, pace) + 0.18 * thrust + air_rev * _rev
	_pitch = lerpf(_pitch, target, 1.0 - exp(-delta * 8.0))
	_engine.pitch_scale = maxf(_pitch, 0.05)
	_engine.volume_db = lerpf(idle_volume, full_volume, clampf(thrust * 0.8 + pace * 0.3, 0.0, 1.0))
	var wet := clampf(craft.contact * 2.0, 0.0, 1.0) * (0.0 if craft.airborne else 1.0)
	_hiss.volume_db = linear_to_db(maxf(wet * clampf(pace, 0.0, 1.0) * 0.22, 0.0001))
	_hiss.pitch_scale = 0.8 + 0.4 * pace


func _splash_now(size: float) -> void:
	_splash.volume_db = linear_to_db(clampf(size, 0.05, 1.0))
	_splash.pitch_scale = randf_range(0.9, 1.1)
	_splash.play()


func _player(node_name: String, stream: AudioStream, bus: StringName) -> AudioStreamPlayer3D:
	var player := AudioStreamPlayer3D.new()
	player.name = node_name
	player.stream = stream
	player.bus = bus
	player.unit_size = unit_size
	player.max_distance = 150.0
	player.doppler_tracking = AudioStreamPlayer3D.DOPPLER_TRACKING_DISABLED
	add_child(player)
	return player
